# Firebase client configuration (Vite reads these at build time).
# Set these in .env.local and in your deployment environment.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Optional: only needed when Firebase Analytics is used.
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

GEMINI_API_KEY=
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MANDI_FEED_URL=
MANDI_FEED_SOURCE_NAME=
MANDI_FEED_API_KEY=

# Server-only Firebase Admin credentials. Keep these out of client bundles.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=agrisence-dd735
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Used only by `npm run admin:create` during the one-time owner setup.
AGRISENCE_ADMIN_ID=main-admin
AGRISENCE_ADMIN_PASSWORD=
AGRISENCE_ADMIN_NAME=AgriSence Main Administrator
AGRISENCE_ADMIN_DISTRICT=National
